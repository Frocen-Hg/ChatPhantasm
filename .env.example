# === 模型密钥（OpenAI 兼容外部 API）===
DEEPSEEK_API_KEY = "sk-你的API密钥"

# === 可选：覆盖默认数据库（默认本地 SQLite data.db）===
# DATABASE_URL = "postgresql+asyncpg://chat:chat@localhost:5432/chatphantasm"

# === 可选：Ollama 本地地址 ===
# OLLAMA_BASE_URL = "http://localhost:11434"

# === 可选：向量库（P2，Chroma 服务模式）===
# 本机开发默认 http://localhost:8001（docker-compose 映射端口）；容器内为 http://chroma:8000
# CHROMA_URL = "http://localhost:8001"
# CHROMA_ENABLED = "true"
# 嵌入模型需在「设置 → 功能位模型 → 嵌入」中单独配置（DeepSeek 无 embeddings 端点）