# === 模型密钥（OpenAI 兼容外部 API）===
DEEPSEEK_API_KEY = "sk-你的API密钥"

# === 可选：默认模型（旧名 deepseek-chat / deepseek-reasoner 已下线）===
# DEFAULT_MODEL = "deepseek-v4-pro"   # 或 deepseek-flash（更快更便宜）

# === 可选：覆盖默认数据库（默认本地 SQLite data.db）===
# DATABASE_URL = "postgresql+asyncpg://chat:chat@localhost:5432/chatphantasm"

# === 可选：Ollama 本地地址 ===
# OLLAMA_BASE_URL = "http://localhost:11434"

# === 可选：向量库（P2，Chroma 服务模式）===
# 本机开发默认 http://localhost:8001（docker-compose 映射端口）；容器内为 http://chroma:8000
# CHROMA_URL = "http://localhost:8001"
# CHROMA_ENABLED = "true"
# 嵌入模型需在「设置 → 功能位模型 → 嵌入」中单独配置（DeepSeek 无 embeddings 端点）

# === 可选：插件系统（仓库根 plugins/ 目录，逗号分隔；留空=全部加载）===
# ENABLED_PLUGINS = "qq"

# === 可选：QQ / NapCat 反向 WebSocket ===
# NapCat 的 websocketClients.token 与此处保持一致；留空表示仅本机/内网直连（不校验）
# QQ_TOKEN = "换成一个随机字符串"
# QQ_ENABLED = "true"
# NapCat.Shell 目录（可选）：设置后可用 POST /api/v1/qq/napcat/config 让插件代写 onebot11.json
# NAPCAT_SHELL_DIR = "H:/git-project/botDevelopSpace/NapCat.Shell"